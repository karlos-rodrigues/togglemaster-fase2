# Copie para .env e preencha. O .env NÃO vai para o Git (ver .gitignore).
#
#   cp .env.example .env
#   sed -i "s/^PG_PASSWORD=.*/PG_PASSWORD=$(openssl rand -hex 16)/" .env
#   sed -i "s/^MASTER_KEY=.*/MASTER_KEY=$(openssl rand -hex 24)/"  .env

# ─── PostgreSQL (as duas instâncias locais) ───
PG_USER=togglemaster
PG_PASSWORD=

# ─── auth-service ───
# Chave mestra que autoriza a criação de novas chaves de API em /admin/keys.
MASTER_KEY=

# ─── evaluation-service ───
# Chave de API de serviço, criada em runtime pelo auth-service.
# Fica vazia na primeira subida; ver passo 3 do README.
SERVICE_API_KEY=

# ─── AWS ───
AWS_REGION=us-east-1

# URL da fila SQS criada na etapa 2 do enunciado.
# Obrigatória: o analytics-service encerra (sys.exit) se ela não estiver definida.
AWS_SQS_URL=

# Tabela do DynamoDB. Localmente é criada no DynamoDB Local pelo perfil 'bootstrap'.
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics

# Credenciais. Localmente o DynamoDB Local aceita qualquer valor; para falar com a
# fila SQS real é preciso credencial de verdade.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Só no AWS Academy (credencial temporária):
AWS_SESSION_TOKEN=
